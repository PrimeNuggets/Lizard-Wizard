  lines:
  - character: {fileID: 11400000, guid: 8d88888bab11f4f47b559f553e401bf8, type: 2}
    emotion: 9
    characterNameOverride: 
    portraitOverride: {fileID: 0}
    sentence: I don't care what else is down here. We're leaving. Now.
  - character: {fileID: 11400000, guid: 2048032ff2c1c7a45a1a7f4fd9824ccb, type: 2}
    emotion: 2
    characterNameOverride: 
    portraitOverride: {fileID: 0}
    sentence: For once, I'm not going to argue. This place is... wrong.
  - character: {fileID: 11400000, guid: 8d88888bab11f4f47b559f553e401bf8, type: 2}
    emotion: 12
    characterNameOverride: 
    portraitOverride: {fileID: 0}
    sentence: Don't look back. Just get to the stairs.
  choices: []
