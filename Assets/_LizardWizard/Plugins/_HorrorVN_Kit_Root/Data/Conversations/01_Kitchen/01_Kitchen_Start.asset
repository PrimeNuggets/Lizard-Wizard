  lines:
  - character: {fileID: 11400000, guid: 8d88888bab11f4f47b559f553e401bf8, type: 2}
    emotion: 9
    characterNameOverride: 
    portraitOverride: {fileID: 0}
    sentence: I can't believe you ordered Chipotle again. We just had it yesterday.
  - character: {fileID: 11400000, guid: 2048032ff2c1c7a45a1a7f4fd9824ccb, type: 2}
    emotion: 5
    characterNameOverride: 
    portraitOverride: {fileID: 0}
    sentence: Look, I needed the fuel. I'm trying to hit a new rank in Tekken tonight.
  - character: {fileID: 11400000, guid: 8d88888bab11f4f47b559f553e401bf8, type: 2}
    emotion: 1
    characterNameOverride: 
    portraitOverride: {fileID: 0}
    sentence: You're going to get sour cream all over the controllers!
  - character: {fileID: 11400000, guid: 2048032ff2c1c7a45a1a7f4fd9824ccb, type: 2}
    emotion: 6
    characterNameOverride: 
    portraitOverride: {fileID: 0}
    sentence: Relax, I'll wash my hands. Probably.
  - character: {fileID: 11400000, guid: 8d88888bab11f4f47b559f553e401bf8, type: 2}
    emotion: 0
    characterNameOverride: 
    portraitOverride: {fileID: 0}
    sentence: ...
  choices:
  - choiceText: Take the controllers
    nextDialogue: {fileID: 11400000, guid: 507cc4f7875ad4b47946df68cd8b0c3f, type: 2}
  - choiceText: Let him eat
    nextDialogue: {fileID: 11400000, guid: 36ed6252a10fd9d4a865d3fd82765995, type: 2}
